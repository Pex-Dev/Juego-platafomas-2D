  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Direcci\xF3n General\r\n\r\nDirector del Proyecto: Brayan\r\nSubdirector
    del Proyecto: Brayan\r\nDirector Ejecutivo de Decisiones Dudosas: Brayan\r\nJefe
    Supremo de Todo: Brayan\r\nPersona que dec\xEDa \u201Cdespu\xE9s arreglo eso\u201D:
    Brayan\r\n\r\nProgramaci\xF3n\r\n\r\nProgramador Principal: Brayan\r\nProgramador
    Secundario: Brayan\r\nProgramador de Emergencias a las 3 AM: Brayan\r\nArquitecto
    de Sistemas: Brayan\r\nEspecialista en Bugs Misteriosos: Brayan\r\nDestructor
    de Bugs (y creador accidental de nuevos): Brayan\r\nExperto en Stack Overflow:
    Brayan\r\nIngeniero de \u201C\xBFPor qu\xE9 no funciona?\u201D: Brayan\r\nProgramador
    de Scripts Improvisados: Brayan\r\nEspecialista en Reiniciar Unity: Brayan\r\nPersona
    que rompi\xF3 algo que s\xED funcionaba: Brayan\r\n\r\nGameplay\r\n\r\nDise\xF1ador
    de Gameplay: Brayan\r\nBalanceador de Dificultad: Brayan\r\nExperto en \u201CEst\xE1
    demasiado dif\xEDcil\u201D: Brayan\r\nExperto en \u201CAhora est\xE1 demasiado
    f\xE1cil\u201D: Brayan\r\nTester de Saltos Imposibles: Brayan\r\nJefe de Mec\xE1nicas
    Dudosas: Brayan\r\n\r\nDise\xF1o de Niveles\r\n\r\nDise\xF1ador de Niveles: Brayan\r\nConstructor
    de Plataformas Mal Puestas: Brayan\r\nEspecialista en Lugares donde el jugador
    se cae: Brayan\r\nIngeniero de Checkpoints: Brayan\r\nColocador Oficial de Enemigos:
    Brayan\r\nExperto en \u201CEsto parec\xEDa divertido en mi cabeza\u201D: Brayan\r\n\r\nArte
    y Visuales\r\n\r\nDirector de Arte: Brayan\r\nArtista Conceptual: Brayan\r\nSupervisor
    de Sprites: Brayan\r\nEncargado de UI: Brayan\r\nDise\xF1ador de Botones: Brayan\r\nPersona
    que aline\xF3 cosas por p\xEDxeles durante 40 minutos: Brayan\r\nEspecialista
    en elegir fuentes: Brayan\r\n\r\nAnimaci\xF3n\r\n\r\nAnimador Principal: Brayan\r\nAnimador
    de Emergencia: Brayan\r\nCorrector de Animaciones Rotas: Brayan\r\nExperto en
    Personajes Desliz\xE1ndose por el Piso: Brayan\r\n\r\nAudio\r\n\r\nDise\xF1ador
    de Sonido: Brayan\r\nIngeniero de Audio: Brayan\r\nPersona que subi\xF3 demasiado
    el volumen accidentalmente: Brayan\r\nSupervisor de Sonidos de Magia: Brayan\r\nEspecialista
    en \u201CEse sonido est\xE1 rar\xEDsimo\u201D: Brayan\r\n\r\nHistoria y Narrativa\r\n\r\nGuionista
    Principal: Brayan\r\nEscritor de Di\xE1logos: Brayan\r\nInventor del Lore: Brayan\r\nPersona
    que cambi\xF3 la historia 12 veces: Brayan\r\nEspecialista en Ideas que Sonaban
    Mejor Antes: Brayan\r\n\r\nAgradecimientos Especiales a Sergio por probar el
    juego\r\ndurante 3 minutos"
  m_isRightToLeft: 0
